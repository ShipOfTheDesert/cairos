# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Jupyter notebook adapter for Cairos"
description:
  "Bytecode-only adapter that renders Cairos_plot SVG output inline in Jupyter cells and provides pretty-printers for Cairos.Series and Cairos.Frame values"
maintainer: ["Miguel Lopez V <miguellova@gmail.com>"]
authors: ["Miguel Lopez V <miguellova@gmail.com>"]
license: "ISC"
homepage: "https://github.com/ShipOfTheDesert/cairos"
doc: "https://shipofthedesert.github.io/cairos"
bug-reports: "https://github.com/ShipOfTheDesert/cairos/issues"
depends: [
  "dune" {>= "3.20"}
  "cairos"
  "cairos_plot"
  "nx"
  "jupyter"
  "ocaml"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ShipOfTheDesert/cairos.git"
x-maintenance-intent: ["(latest)"]
